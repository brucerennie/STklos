;; This is an embedded SRFI
(define-library (srfi 192)
  (import (only SCHEME
                 port-has-port-position? port-position
                 port-has-set-port-position!? set-port-position!
                 make-i/o-invalid-position-error i/o-invalid-position-error?))
  (export port-has-port-position? port-position
          port-has-set-port-position!? set-port-position!
          make-i/o-invalid-position-error i/o-invalid-position-error?))

(provide "srfi/192")
